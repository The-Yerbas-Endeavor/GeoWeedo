{
  "name": "geoweedo",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "predev": "node ./scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node ./scripts/copy-maplibre-worker.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "deploy": "bash scripts/deploy-no-downtime.sh",
    "db:init": "node --conditions=react-server --experimental-strip-types scripts/init-db.mjs",
    "admin:create": "bash scripts/create-admin.sh",
    "weedo:ingest:sc-labs": "node --conditions=react-server --experimental-strip-types scripts/ingest-sc-labs.mjs",
    "weedo:import:sc-labs": "node --experimental-loader ./scripts/ts-extension-loader.mjs --conditions=react-server --experimental-strip-types scripts/import-sc-labs-public.mjs",
    "weedo:import:kannapedia": "node --experimental-loader ./scripts/ts-extension-loader.mjs --conditions=react-server --experimental-strip-types scripts/import-kannapedia-public.mjs",
    "weedo:import:cannlytics": "python3 scripts/import-cannlytics-public.py",
    "searxng:enable-engines": "sudo bash scripts/configure-searxng-engines.sh",
    "wallet:worker": "node --env-file=.env.local scripts/yerb-wallet-worker.mjs",
    "rewards:dry-run": "node --env-file=.env.local scripts/yerb-payout-worker.mjs",
    "rewards:pay": "node --env-file=.env.local scripts/yerb-payout-worker.mjs --execute"
  },
  "dependencies": {
    "@photo-sphere-viewer/core": "5.15.1",
    "maplibre-gl": "6.4.1",
    "next": "16.3.3",
    "pdf-parse": "2.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.7.4",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.6.2"
  }
}
