{
  "name": "geoweedo",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "bash scripts/deploy-zero-downtime.sh",
    "deploy:install": "bash scripts/install-zero-downtime.sh",
    "db:init": "node --conditions=react-server --experimental-strip-types scripts/init-db.mjs",
    "admin:create": "bash scripts/create-admin.sh",
    "wallet:worker": "node --env-file=.env.local scripts/yerb-wallet-worker.mjs",
    "rewards:dry-run": "node --env-file=.env.local scripts/yerb-payout-worker.mjs",
    "rewards:pay": "node --env-file=.env.local scripts/yerb-payout-worker.mjs --execute"
  },
  "dependencies": {
    "@photo-sphere-viewer/core": "5.15.1",
    "maplibre-gl": "6.3.0",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.7.4",
    "@types/react": "18.3.10",
    "@types/react-dom": "18.3.0",
    "typescript": "5.6.2"
  }
}
