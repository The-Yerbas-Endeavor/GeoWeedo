# GeoWeedo requires no Google Maps API key and no Google billing account.
# MapLibre/OpenFreeMap powers the guessing map and KartaView powers street imagery.

# Required for /admin/dispensaries. Use a long random value and keep it server-side.
GEOWEEDO_ADMIN_SECRET=

# Public reward display policy. Defaults shown below can be tuned without changing game scoring.
NEXT_PUBLIC_YERB_PER_POINT=0.0004
NEXT_PUBLIC_YERB_DAILY_CAP=25

# Reserved for the future server-side Yerbas payout worker. Do not expose these to the browser.
YERB_RPC_URL=http://127.0.0.1:15419
YERB_RPC_USER=
YERB_RPC_PASSWORD=
