# MapLibre/OpenFreeMap powers the main map.
# Street imagery can use Google Street View, KartaView, or Google-first automatic fallback.
# Values: google | kartaview | auto
STREET_IMAGERY_PROVIDER=kartaview

# Server-side Google Maps Platform key used only for Street View metadata/static imagery.
# Do not expose this as NEXT_PUBLIC_* and do not commit a real key.
GOOGLE_MAPS_API_KEY=

# Session signing/rotation secret for application sessions and future CSRF/session hardening.
# Generate with: openssl rand -hex 32
GEOWEEDO_SESSION_SECRET=

# Public reward display policy. Defaults shown below can be tuned without changing game scoring.
NEXT_PUBLIC_YERB_PER_POINT=0.0004
NEXT_PUBLIC_YERB_DAILY_CAP=25

# Optional public sponsorship receiving address.
NEXT_PUBLIC_YERB_SPONSOR_ADDRESS=

# Server-side Yerbas RPC. Required for wallet-signature login, deposit-address generation,
# deposit scanning, and the restricted withdrawal worker.
YERB_RPC_URL=http://127.0.0.1:15419
YERB_RPC_USER=
YERB_RPC_PASSWORD=

# Number of confirmations required before a detected deposit becomes spendable.
YERB_DEPOSIT_CONFIRMATIONS=6

# Withdrawal worker safety switch. Keep false until RPC wallet backups and admin approval flow are verified.
YERB_WITHDRAWALS_ENABLED=false

# Legacy reward payout worker safety switch. Keep false while rewards migrate fully to wallet_ledger.
YERB_PAYOUTS_ENABLED=false
