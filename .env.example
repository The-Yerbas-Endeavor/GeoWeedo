# GeoWeedo requires no Google Maps API key and no Google billing account.
# MapLibre/OpenFreeMap powers the guessing map and KartaView/GeoWeedo-hosted files power street imagery.

# Required for admin pages. Use a long random value and keep it server-side.
GEOWEEDO_ADMIN_SECRET=

# Separate signing secret for future authenticated player sessions. Use a different long random value.
GEOWEEDO_SESSION_SECRET=

# Public reward display policy. Defaults shown below can be tuned without changing game scoring.
NEXT_PUBLIC_YERB_PER_POINT=0.0004
NEXT_PUBLIC_YERB_DAILY_CAP=25

# Optional public sponsorship receiving address shown to businesses in a later self-service flow.
NEXT_PUBLIC_YERB_SPONSOR_ADDRESS=

# Server-side Yerbas RPC. Required for read-only wallet-message verification and the isolated payout worker.
YERB_RPC_URL=http://127.0.0.1:15419
YERB_RPC_USER=
YERB_RPC_PASSWORD=

# Payout worker safety switch. Keep false until the reward wallet, backups, limits, and dry-run output are verified.
YERB_PAYOUTS_ENABLED=false
