# MapLibre/OpenFreeMap powers the main map.
# Street imagery can use Google Street View, KartaView, or Google-first automatic fallback.
# Values: google | kartaview | auto
# The admin panel can override this value at runtime without editing the environment file.
STREET_IMAGERY_PROVIDER=kartaview

# Server-side Google Maps Platform key used for Street View metadata/static imagery.
# Google Places enrichment falls back to this key when GOOGLE_PLACES_API_KEY is unset.
# Do not expose this as NEXT_PUBLIC_* and do not commit a real key.
GOOGLE_MAPS_API_KEY=

# Optional separate server-side key for Places API (New) automated dispensary enrichment.
# Recommended for independent API restrictions/quotas. Enable Places API (New) for this key.
GOOGLE_PLACES_API_KEY=

# Preferred official-site discovery provider: a self-hosted SearXNG instance.
# Example: http://127.0.0.1:8888 or https://search.example.org
# SearXNG must have JSON output enabled. No commercial search API key is required.
SEARXNG_URL=

# Discovery safety controls. These defaults pace requests, retry temporary failures,
# time out stalled searches, and reuse successful results for 30 days.
SITE_SEARCH_MIN_INTERVAL_MS=1200
SITE_SEARCH_TIMEOUT_MS=12000
SITE_SEARCH_MAX_RETRIES=3
SITE_SEARCH_CACHE_TTL_MS=2592000000

# Official website enrichment fetch controls. Fetches are concurrency-limited and paced
# per host, use manual redirect validation, reject private/internal network destinations,
# time out stalled sites, and cap the HTML body read into memory.
WEBSITE_FETCH_MAX_CONCURRENCY=3
WEBSITE_FETCH_HOST_INTERVAL_MS=1500
WEBSITE_FETCH_TIMEOUT_MS=12000
WEBSITE_FETCH_MAX_BYTES=4000000
WEBSITE_FETCH_MAX_REDIRECTS=5

# Optional legacy fallback for official-site discovery.
# Keep these only if this installation already has Google Custom Search access.
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=

# Default daily warning threshold for Google Street View image requests.
# The admin panel can change this at runtime. Set 0 to disable the warning.
GOOGLE_STREET_VIEW_DAILY_WARNING=500

# Session signing/rotation secret for application sessions and future CSRF/session hardening.
# Generate with: openssl rand -hex 32
GEOWEEDO_SESSION_SECRET=

# Public reward display policy. Defaults shown below can be tuned without changing game scoring.
NEXT_PUBLIC_YERB_PER_POINT=0.0004
NEXT_PUBLIC_YERB_DAILY_CAP=25

# Optional public sponsorship receiving address.
NEXT_PUBLIC_YERB_SPONSOR_ADDRESS=

# Server-side Yerbas RPC. Required for wallet-signature login, deposit-address generation,
# deposit scanning, and the restricted withdrawal worker.
YERB_RPC_URL=http://127.0.0.1:15419
YERB_RPC_USER=
YERB_RPC_PASSWORD=

# Number of confirmations required before a detected deposit becomes spendable.
YERB_DEPOSIT_CONFIRMATIONS=6

# Withdrawal worker safety switch. Keep false until RPC wallet backups and admin approval flow are verified.
YERB_WITHDRAWALS_ENABLED=false

# Legacy reward payout worker safety switch. Keep false while rewards migrate fully to wallet_ledger.
YERB_PAYOUTS_ENABLED=false
